# Copy this file to .env and fill in your API keys

# Adzuna API (register at https://developer.adzuna.com/signup)
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# USAJobs API (register at https://developer.usajobs.gov/apirequest/)
USAJOBS_API_KEY=your_usajobs_key
USAJOBS_USER_AGENT=your@email.com

# BLS API (optional — increases rate limits, register at https://data.bls.gov/registrationEngine/)
BLS_API_KEY=your_bls_key
