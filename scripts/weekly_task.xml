<!-- Windows Task Scheduler XML for weekly job-market-tool ingest -->
<!-- Import via: schtasks /create /tn "JobMarketTool_Weekly" /xml weekly_task.xml -->
<!-- Or via Task Scheduler GUI: Import XML -->

<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Weekly ingest for Job Market Tool — fetches BLS, Adzuna, Muse, RemoteOK data and recomputes growth scores</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T06:00:00</StartBoundary>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Sunday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- Update these paths to match your installation -->
      <Command>E:\agent\Software\job-market-tool\.venv\Scripts\python.exe</Command>
      <Arguments>-m job_market.ingest.run_weekly</Arguments>
      <WorkingDirectory>E:\agent\Software\job-market-tool</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
